rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'jesussoler2003@gmail.com'; }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if admin();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if admin();
      match /attendees/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'companions', 'createdAt'])
          && request.resource.data.companions is int
          && request.resource.data.companions >= 0
          && request.resource.data.companions <= 10;
        allow delete: if admin() || (signedIn() && request.auth.uid == uid);
      }
    }
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
